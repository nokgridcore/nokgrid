{
	"name": "@nokgridcore/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./src/*.tsx"
	},
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"generate:component": "turbo gen react-component",
		"check-types": "tsc --noEmit",
		"icons": "svgr --config-file svgr.config.js --out-dir src/icons/generated src/icons/svg && node scripts/fix-icon-exports.js",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@nokgridcore/eslint-config": "workspace:*",
		"@nokgridcore/typescript-config": "workspace:*",
		"@storybook/addon-a11y": "^10.5.2",
		"@storybook/addon-docs": "^10.5.2",
		"@storybook/addon-mcp": "^0.7.0",
		"@storybook/react-vite": "^10.5.2",
		"@svgr/cli": "^8.1.0",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"autoprefixer": "^10.5.4",
		"eslint": "^9.39.1",
		"eslint-plugin-storybook": "^10.5.2",
		"playwright": "^1.61.1",
		"postcss": "^8.5.19",
		"postcss-cli": "^11.0.1",
		"postcss-import": "^16.1.1",
		"storybook": "^10.5.2",
		"tailwindcss": "^3.4.19",
		"typescript": "5.9.2"
	},
	"dependencies": {
		"@nokgridcore/tokens": "workspace:^",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}
