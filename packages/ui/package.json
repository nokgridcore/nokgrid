	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"generate:component": "turbo gen react-component",
		"check-types": "tsc --noEmit",
		"icons": "svgr --config-file svgr.config.js --out-dir src/icons/generated src/icons/svg && node scripts/fix-icon-exports.js",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy": "pnpm --filter @nokgridcore/tokens run tokens && pnpm run build-storybook",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "pnpm run clean && pnpm run build:js && pnpm run build:css",
		"build:js": "tsc -p tsconfig.build.json",
		"build:css": "postcss src/globals.css -o dist/styles.css",
		"prepack": "pnpm run build"
	},
